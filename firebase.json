{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "kino",
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", "skills-lock.json",
      "**/.*", "**/.*/**", "**/node_modules/**",
      "**/*.md", "**/*.bat", "**/*.ps1",
      "graphify-out/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
